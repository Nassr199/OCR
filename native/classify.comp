#version 450
// Vulkan compute version of ScanMask.classify (core/SubScan.kt): the per-pixel stage of the
// subtitle text detector. One invocation = 4 pixels packed in one uint, so writes never race.
// v = luma (inverted for dark text); d = v - min over the (2r+1)^2 window (edges clamped);
// class 2 (strong) when v >= brightHigh && d >= contrastHigh && ridge(v - contrastHigh);
// class 1 (weak) when v >= brightLow && d >= contrastLow; else 0.
// ridge = a darker pixel left AND right, or above AND below, within ridgeRadius.
// Integer-only, so the result is bit-identical to the CPU version.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer In { uint lum[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Out { uint cls[]; };
layout(push_constant) uniform P {
    ivec4 size;   // w, h, n, ridgeRadius
    ivec4 th;     // brightHigh, contrastHigh, brightLow, contrastLow
    ivec4 mode;   // invert, minRadius, -, -
} pc;

int px(int x, int y) {
    int i = y * pc.size.x + x;
    int v = int((lum[i >> 2] >> uint((i & 3) * 8)) & 255u);
    return pc.mode.x == 1 ? 255 - v : v;
}

bool ridge(int x, int y, int limit) {
    int w = pc.size.x; int h = pc.size.y; int r = pc.size.w;
    bool a = false; bool b = false;
    for (int k = 1; k <= r; k++) {
        if (!a && x - k >= 0 && px(x - k, y) <= limit) a = true;
        if (!b && x + k < w && px(x + k, y) <= limit) b = true;
        if (a && b) return true;
    }
    a = false; b = false;
    for (int k = 1; k <= r; k++) {
        if (!a && y - k >= 0 && px(x, y - k) <= limit) a = true;
        if (!b && y + k < h && px(x, y + k) <= limit) b = true;
        if (a && b) return true;
    }
    return false;
}

void main() {
    int word = int(gl_GlobalInvocationID.x);
    int w = pc.size.x; int h = pc.size.y; int n = pc.size.z; int mr = pc.mode.y;
    if (word * 4 >= n) return;
    uint outWord = 0u;
    for (int k = 0; k < 4; k++) {
        int i = word * 4 + k;
        if (i >= n) break;
        if (w < 3 || h < 3) continue;
        int x = i % w; int y = i / w;
        int c = px(x, y);
        uint cl = 0u;
        if (c >= pc.th.z) {
            int m = 255;
            for (int yy = max(0, y - mr); yy <= min(h - 1, y + mr); yy++)
                for (int xx = max(0, x - mr); xx <= min(w - 1, x + mr); xx++)
                    m = min(m, px(xx, yy));
            int d = c - m;
            if (c >= pc.th.x && d >= pc.th.y && ridge(x, y, c - pc.th.y)) cl = 2u;
            else if (d >= pc.th.w) cl = 1u;
        }
        outWord |= cl << uint(k * 8);
    }
    cls[word] = outWord;
}
